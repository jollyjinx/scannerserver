+static bool scan_response_is_error(const uint8_t *response, size_t len,
+                                   int32_t *error_code) {
+    if (len < 12 || memcmp(response + 4, "VENS", 4) != 0) return false;
+    int32_t code = (int32_t)get_be32(response + 8);
+    if (code == 0) return false;
+    if (error_code) *error_code = code;
+    return true;
+}
+
+static bool scan_response_reports_feeder_empty(const uint8_t *response, size_t len) {
+    static const uint8_t empty_status[12] = {
+        0x00, 0x0a, 0x00, 0x00, 0x00, 0x00,
+        0x80, 0x03, 0x00, 0x00, 0x00, 0x00,
+    };
+    return len >= sizeof(empty_status)
+        && memcmp(response + len - sizeof(empty_status),
+                  empty_status, sizeof(empty_status)) == 0;
+}
+
 static int recv_jpeg(int fd, uint8_t *prepend, size_t prepend_len,
@@ -931,3 +950,4 @@

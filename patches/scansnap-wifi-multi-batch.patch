 struct page { uint8_t *data; size_t len; };
 
+static void free_pages(struct page *pages, size_t count) {
+    if (!pages) return;
+    for (size_t i = 0; i < count; i++) free(pages[i].data);
+    free(pages);
+}
+
+static int append_batch_pages(struct page **pages, size_t *count,
+                              size_t *capacity, struct page *batch,
+                              int batch_count, bool simplex) {
+    for (int i = 0; i < batch_count; i++) {
+        if (simplex && i % 2 == 1) {
+            free(batch[i].data);
+            batch[i].data = NULL;
+            batch[i].len = 0;
+            continue;
+        }
+
+        if (*count == *capacity) {
+            size_t new_capacity = *capacity == 0 ? MAX_PAGES : *capacity * 2;
+            if (new_capacity < *capacity
+                || new_capacity > SIZE_MAX / sizeof(struct page)) return -1;
+            struct page *grown = realloc(*pages, new_capacity * sizeof(struct page));
+            if (!grown) return -1;
+            memset(grown + *capacity, 0,
+                   (new_capacity - *capacity) * sizeof(struct page));
+            *pages = grown;
+            *capacity = new_capacity;
+        }
+
+        (*pages)[*count] = batch[i];
+        (*count)++;
+        batch[i].data = NULL;
+        batch[i].len = 0;
+    }
+    return 0;
+}
